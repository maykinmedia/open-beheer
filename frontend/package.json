{
  "name": "open-beheer",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "commitlint": "commitlint --edit",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "prepare": "cd .. && husky frontend/.husky",
    "start": "npm run dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage --watch=false",
    "update-types": "npx openapi-typescript ../backend/openbeheer-oas.yaml -o ./src/types/api.d.ts",
    "check-types": "npx openapi-typescript ../backend/openbeheer-oas.yaml -o ./src/types/api.d.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@maykin-ui/admin-ui": "^3.0.0-rc.1",
    "@maykin-ui/client-common": "^0.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.39.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@maykinmedia/eslint-config": "^1.0.0",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-storybook": "10.5.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "msw-storybook-addon": "^2.0.4",
    "openapi-typescript": "^7.8.0",
    "playwright": "^1.51.1",
    "prettier": "^3.5.3",
    "storybook": "10.5.5",
    "storybook-addon-remix-react-router": "^7.0.0",
    "typescript": "~5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,md}": [
      "npm run lint:fix",
      "ast-grep scan || npx ast-grep scan"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {}
}
